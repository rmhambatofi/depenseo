{
  "name": "depenseo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint scripts eslint.config.mjs && pnpm -r --if-present lint",
    "lint:ci": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12 -color",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:tz": "pnpm -r --if-present test:tz"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
