{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "vite.login.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
