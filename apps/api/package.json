{
  "name": "@depenseo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @depenseo/shared build && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:tz": "for tz in Europe/Paris Europe/Lisbon America/Montreal Indian/Reunion; do TZ=$tz vitest run --passWithNoTests tz.spec || exit 1; done",
    "openapi": "pnpm build && node dist/scripts/openapi.js",
    "migrate": "pnpm build && node dist/scripts/migrate.js",
    "jobs:run": "node dist/scripts/jobs-run.js",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.3",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@depenseo/shared": "workspace:*",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.15",
    "mysql2": "3.24.6",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  }
}
