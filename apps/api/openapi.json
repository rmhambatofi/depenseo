  "info": {
    "title": "Depenseo API",
    "description": "API de suivi des dépenses. Montants en centimes, dates calendaires AAAA-MM-JJ.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "acceptTerms": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Acceptation des CGU et de la politique de confidentialité"
          },
          "language": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "default": "fr"
          }
        },
        "required": [
          "email",
          "password",
          "acceptTerms"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Jeton reçu par e-mail (base64url, 43 caractères)"
          }
        },
        "required": [
          "token"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionTokensDto": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "accessToken": {
            "type": "string",
            "description": "JWT à présenter en `Authorization: Bearer …`"
          },
          "expiresIn": {
            "type": "number",
            "description": "Durée de validité du jeton d’accès (s)",
            "example": 900
          },
          "refreshToken": {
            "type": "string",
            "description": "Jeton opaque à usage unique, à échanger sur /auth/refresh"
          },
          "refreshExpiresIn": {
            "type": "number",
            "description": "Durée de validité du jeton de rafraîchissement (s)",
            "example": 2592000
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "expiresIn",
          "refreshToken",
          "refreshExpiresIn"
        ]
      },
      "SocialLoginDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "apple",
              "google"
            ]
          },
          "idToken": {
            "type": "string",
            "description": "`id_token` (JWT) remis par Apple ou Google",
            "maxLength": 8192
          },
          "nonce": {
            "type": "string",
            "description": "Nonce brut ; le fournisseur doit avoir reçu son SHA-256 hexadécimal",
            "minLength": 16,
            "maxLength": 128
          },
          "acceptTerms": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Requis pour créer un compte ou reprendre un compte non vérifié (sinon 422)"
          },
          "language": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "default": "fr",
            "description": "Langue d’un compte créé"
          }
        },
        "required": [
          "provider",
          "idToken",
          "nonce"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Jeton de rafraîchissement (base64url, 43 caractères)"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "PasswordResetRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetConfirmDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Jeton reçu par e-mail (base64url, 43 caractères)"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "language": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ]
          },
          "timeZone": {
            "type": "string",
            "description": "Fuseau IANA, ex. Europe/Paris",
            "example": "Europe/Paris"
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "CHF",
              "GBP",
              "USD",
              "CAD",
              "SEK",
              "NOK",
              "DKK",
              "PLN",
              "CZK",
              "HUF",
              "RON",
              "ISK",
              "MAD",
              "TND",
              "MGA",
              "MUR",
              "XOF",
              "XAF",
              "XPF",
              "JPY"
            ],
            "description": "Code ISO 4217"
          },
          "termsAcceptedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Acceptation des CGU (UTC)"
          },
          "privacyAcceptedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Acceptation de la politique de confidentialité (UTC)"
          }
        },
        "required": [
          "id",
          "email",
          "language",
          "timeZone",
          "currency",
          "termsAcceptedAt",
          "privacyAcceptedAt"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ]
          },
          "timeZone": {
            "type": "string",
            "maxLength": 64,
            "description": "Fuseau IANA (`Zone/Lieu` ou `UTC`) ; décalages fixes et abréviations refusés",
            "example": "America/Montreal"
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "CHF",
              "GBP",
              "USD",
              "CAD",
              "SEK",
              "NOK",
              "DKK",
              "PLN",
              "CZK",
              "HUF",
              "RON",
              "ISK",
              "MAD",
              "TND",
              "MGA",
              "MUR",
              "XOF",
              "XAF",
              "XPF",
              "JPY"
            ],
            "description": "Code ISO 4217"
          }
        }
      },
      "NotebookDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "personal",
              "shared"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ],
            "description": "Rôle du compte connecté dans ce carnet"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "role"
        ]
      },
      "CategoryDto": {
